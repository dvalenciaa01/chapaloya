# ==========================================================================
# Bot de WhatsApp · Reservalope
# Copia este archivo como ".env" (en esta misma carpeta bot/) y completa los valores.
# ".env" nunca se sube a GitHub.
# ==========================================================================

# Supabase → Project Settings → API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# "Secret key" (en proyectos antiguos se llama "service_role key"). Solo va aquí y en las Edge Functions.
SUPABASE_SECRET_KEY=

# Clave para cifrar las sesiones de WhatsApp guardadas en esta máquina (64 caracteres).
# Genérala una sola vez con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si la cambias o la pierdes, hay que volver a vincular cada WhatsApp.
BOT_SESSION_KEY=

# Este archivo puede ir aquí (bot/.env), en %ProgramData%\Reservalope\bot.env
# (Windows) o en la ruta que indique la variable de sistema BOT_ENV_FILE.

# Cada cuántos segundos revisa la cola de mensajes
BOT_POLL_SECONDS=30
# Espera aleatoria entre un mensaje y otro (segundos), para no parecer spam
BOT_MIN_DELAY_SECONDS=8
BOT_MAX_DELAY_SECONDS=20
# Cuántos mensajes toma de una vez por barbería (cada barbería envía por su lado)
BOT_BATCH_PER_TENANT=5
# Respuestas de un mismo número que se procesan como máximo (las demás se ignoran)
BOT_INBOUND_MAX=5
BOT_INBOUND_WINDOW_MINUTES=10
# Intentos de reconexión con WhatsApp antes de rendirse (la espera crece hasta 5 min)
BOT_MAX_RECONNECTS=40
# Carpeta del registro (logs/bot.log, rota cada día o a los 5 MB y guarda 10 archivos)
BOT_LOG_DIR=logs
# Puerto local para comprobar que el bot está vivo (curl http://127.0.0.1:8080). 0 = apagado
BOT_HEALTH_PORT=8080
# Carpeta donde se guardan las sesiones cifradas
BOT_SESSIONS_DIR=sessions
# Zona horaria del servidor (solo afecta a los registros; los horarios los calcula la base de datos)
TZ=America/Lima
