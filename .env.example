# ==========================================================================
# Variables de entorno · Reservalope
# Copia este archivo como ".env" y completa los valores.
# ".env" está en .gitignore: NUNCA lo subas a GitHub.
# ==========================================================================

# --------------------------------------------------------------------------
# 1) PÚBLICAS · las usa la web (index, reservar, CRM). Se pueden ver en el
#    navegador; la seguridad la dan las reglas RLS de la base de datos.
#    Como la web es HTML estático, en la Fase 1 irán en js/config.js.
# --------------------------------------------------------------------------
# Supabase → Project Settings → API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# "Publishable key" (en proyectos antiguos se llama "anon key")
SUPABASE_PUBLISHABLE_KEY=

# Cloudflare → Turnstile → tu sitio → "Site key"
TURNSTILE_SITE_KEY=

# --------------------------------------------------------------------------
# 2) SECRETAS · solo en el servidor del bot (VM) y en las Edge Functions de
#    Supabase. Jamás en el frontend, en capturas de pantalla ni en GitHub.
# --------------------------------------------------------------------------
# "Secret key" (en proyectos antiguos se llama "service_role key").
# Salta las reglas RLS: quien la tenga controla toda la base de datos.
SUPABASE_SECRET_KEY=

# Cloudflare → Turnstile → "Secret key" (la usa la función que crea reservas)
TURNSTILE_SECRET_KEY=

# Clave para cifrar las sesiones de WhatsApp guardadas en la VM.
# Genérala con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOT_SESSION_KEY=

# Ajustes del bot
BOT_POLL_SECONDS=30
BOT_MIN_DELAY_SECONDS=8
BOT_MAX_DELAY_SECONDS=20
BOT_HEALTH_PORT=8080
TZ=America/Lima

# --------------------------------------------------------------------------
# 3) CORREO (SMTP) · NO va en este archivo: se configura en
#    Supabase → Authentication → Emails → SMTP Settings
#    con los datos que te da Brevo o Resend.
# --------------------------------------------------------------------------
